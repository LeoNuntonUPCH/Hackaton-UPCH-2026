# SATQ Digital — credenciales de mensajería.
#
# Copia este archivo a ".env" (sin ".example") y rellena tus valores.
# El archivo ".env" NUNCA se sube al repositorio — ya está en .gitignore.
#
# Si no existe .env, el sistema funciona en modo simulado: el botón dice
# "Simular envío" y no sale ningún mensaje real. Esa es la condición por
# defecto y la que conviene para una demostración controlada.
#
# Instrucciones completas: ver GUIA_MENSAJERIA.md

# ===========================================================================
# OPCIÓN A — Telegram  (la que funciona sin verificación, tarjeta ni saldo)
# ===========================================================================
# Se crea un bot escribiendo /newbot a @BotFather en Telegram. El token que
# devuelve va aquí. Es el canal recomendado para la demostración.
TELEGRAM_BOT_TOKEN=

# Identificadores de conversación (chat_id), separados por coma. NO son
# números de teléfono. Para obtenerlos: que cada persona pulse START en el
# bot y luego ejecutar  python obtener_chat_id.py
TELEGRAM_CHAT_IDS=

# ===========================================================================
# OPCIÓN B — Meta WhatsApp Cloud API  (gratis, pero exige verificar la cuenta)
# ===========================================================================
# Es la API oficial de WhatsApp. Meta entrega un número de prueba gratuito
# que envía a hasta 5 destinatarios verificados, sin saldo ni tarjeta.
# Se obtiene en https://developers.facebook.com → tu app → WhatsApp → API Setup

# Token de acceso temporal (dura 24 h) o permanente (ver guía).
META_WHATSAPP_TOKEN=

# "Phone number ID" del número de prueba. OJO: es el ID numérico que muestra
# el panel, no el número de teléfono.
META_WHATSAPP_PHONE_ID=

# Versión de la Graph API. Si el panel de Meta muestra otra en su ejemplo de
# código, usa esa.
META_WHATSAPP_VERSION=v21.0

# ===========================================================================
# OPCIÓN C — Twilio  (requiere cuenta de pago para WhatsApp)
# ===========================================================================
# Se mantiene como alternativa. Una cuenta Twilio de prueba NO sirve para
# enviar WhatsApp por código: las plantillas exigen cuenta de pago. Para SMS
# hace falta además un número propio y saldo.
# Panel: https://console.twilio.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp por Twilio: número del Sandbox, con el prefijo "whatsapp:".
TWILIO_WHATSAPP_FROM=

# SMS: número de Twilio propio, en formato internacional. Ejemplo: +15005550006
TWILIO_SMS_FROM=

# Plantilla aprobada (ContentSid, empieza con HX). Solo para cuentas de pago.
TWILIO_WHATSAPP_CONTENT_SID=

# ===========================================================================
# DESTINATARIOS (común a ambas opciones)
# ===========================================================================
# Números reales a los que SÍ deben llegar los mensajes de prueba, separados
# por coma y en formato internacional. Con Meta, cada uno debe estar añadido
# como destinatario verificado en el panel.
# Ejemplo: +51987654321, +51911111111
TWILIO_DESTINATARIOS_PRUEBA=

# --- Solo para pruebas automatizadas (no tocar en uso normal) --------------
# TWILIO_API_BASE=https://api.twilio.com
# META_API_BASE=https://graph.facebook.com
# TELEGRAM_API_BASE=https://api.telegram.org
